<%- include('../partials/head', { title: 'Administración' }) %>
<%- include('../partials/admin_nav') %>

<main id="main" class="container">
  <div class="page-title"><h1>Métricas de la plataforma</h1></div>

  <%- include('../partials/flash') %>

  <div class="stats">
    <div class="stat"><div class="num"><%= metrics.restaurants %></div><div class="label">Establecimientos</div></div>
    <div class="stat"><div class="num"><%= metrics.restaurantsActive %></div><div class="label">Activos</div></div>
    <div class="stat"><div class="num"><%= metrics.applications %></div><div class="label">Candidaturas totales</div></div>
    <div class="stat"><div class="num"><%= metrics.applications7d %></div><div class="label">Últimos 7 días</div></div>
    <div class="stat"><div class="num"><%= metrics.users %></div><div class="label">Usuarios</div></div>
    <div class="stat"><div class="num"><%= metrics.usersBlocked %></div><div class="label">Bloqueados</div></div>
    <div class="stat"><div class="num"><%= metrics.jobs %></div><div class="label">Vacantes</div></div>
    <div class="stat <%= metrics.notificationsFailed > 0 ? 'is-alert' : '' %>"><div class="num"><%= metrics.notificationsFailed %></div><div class="label">Emails fallidos</div></div>
  </div>

  <% if (failed.length > 0) { %>
    <div class="card danger-zone">
      <h2>Notificaciones fallidas recientes</h2>
      <div class="table-wrap">
        <table class="table table-stack">
          <thead>
            <tr><th>ID</th><th>Establecimiento</th><th>Error</th><th>Fecha</th></tr>
          </thead>
          <tbody>
            <% failed.forEach(function(n) { %>
              <tr>
                <td data-label="ID"><%= n.id %></td>
                <td data-label="Establecimiento"><%= n.restaurant_id %></td>
                <td class="small" data-label="Error"><%= n.detail %></td>
                <td class="nowrap small" data-label="Fecha"><%= fmtDate(n.created_at) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>

  <div class="card">
    <h2>Establecimientos</h2>
    <p class="help help-lift">
      Esta área no da acceso a candidaturas, candidatos ni currículums: la
      administración de la plataforma ve métricas y metadatos, no datos
      personales de candidatos.
    </p>

    <% if (restaurants.length === 0) { %>
      <p class="dim flat">Sin establecimientos todavía.</p>
    <% } else { %>
      <div class="table-wrap">
        <table class="table table-stack">
          <thead>
            <tr>
              <th>Establecimiento</th><th>Slug</th><th>Responsable</th>
              <th>Candidaturas</th><th>Owners</th><th>Plan</th><th>Estado</th><th><span class="sr-only">Acciones</span></th>
            </tr>
          </thead>
          <tbody>
            <% restaurants.forEach(function(r) { %>
              <tr>
                <td data-label="Establecimiento"><div>
                  <strong><%= r.name %></strong>
                  <div class="dim tiny"><%= r.city %></div>
                </div></td>
                <td class="small" data-label="Slug">
                  <a href="/r/<%= r.slug %>" target="_blank" rel="noopener">/r/<%= r.slug %></a>
                </td>
                <td class="small" data-label="Responsable"><div>
                  <%= r.owner_name %>
                  <div class="dim tiny"><%= r.email %></div>
                </div></td>
                <td data-label="Candidaturas"><%= r.apps %></td>
                <td data-label="Owners"><%= r.owners %></td>
                <td class="nowrap small" data-label="Plan"><div>
                  <%# Plano (0014). O estado da assinatura vem do webhook da Stripe. %>
                  <% var planLabel = { trial: 'Prueba', founders: 'Fundadores', pro: 'Profesional' }[r.plan] || r.plan; %>
                  <strong><%= planLabel %></strong><% if (r.billing_interval) { %> <span class="dim tiny"><%= r.billing_interval === 'year' ? 'anual' : 'mensual' %></span><% } %>
                  <% if (r.subscription_status) { %>
                    <div><span class="badge <%= ['active', 'trialing'].indexOf(r.subscription_status) !== -1 ? 'green' : (['past_due', 'unpaid', 'incomplete'].indexOf(r.subscription_status) !== -1 ? 'amber' : 'slate') %>"><%= r.subscription_status %></span></div>
                  <% } %>
                </div></td>
                <td class="nowrap" data-label="Estado"><div>
                  <span class="badge <%= r.active ? 'green' : 'red' %>"><%= r.active ? 'Activo' : 'Desactivado' %></span>
                  <% if (r.hiring_status === 'paused') { %>
                    <span class="badge amber">Pausado</span>
                  <% } %>
                </div></td>
                <td class="td-actions">
                  <form action="/admin/restaurantes/<%= r.id %>/toggle" method="post">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="quiero" value="<%= r.active ? 0 : 1 %>">
                    <button class="btn secondary small" type="submit"><%= r.active ? 'Desactivar' : 'Activar' %></button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</main>

<%- include('../partials/foot') %>
