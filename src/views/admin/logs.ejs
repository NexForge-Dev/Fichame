<%- include('../partials/head', { title: 'Logs de seguridad' }) %>
<%- include('../partials/admin_nav') %>

<main id="main" class="container">
  <div class="page-title"><h1>Logs de seguridad</h1></div>

  <%- include('../partials/flash') %>

  <div class="card">
    <form action="/admin/logs" method="get">
      <div class="filters">
        <div class="field">
          <label for="event">Evento</label>
          <select id="event" name="event">
            <option value="">Todos</option>
            <% events.forEach(function(e) { %>
              <option value="<%= e %>" <%= filters.event === e ? 'selected' : '' %>><%= e %></option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="actions-row tight">
        <button class="btn small" type="submit">Filtrar</button>
        <a class="btn secondary small" href="/admin/logs">Limpiar</a>
      </div>
    </form>
  </div>

  <% if (logs.length === 0) { %>
    <div class="card empty">
      <span class="empty-icon" aria-hidden="true"><%- icon('shield') %></span>
      <p>Sin registros.</p>
    </div>
  <% } else { %>
    <div class="card">
      <div class="table-wrap">
        <table class="table table-stack">
          <thead>
            <tr><th>ID</th><th>Fecha</th><th>Evento</th><th>IP</th><th>Detalle</th></tr>
          </thead>
          <tbody>
            <% logs.forEach(function(l) { %>
              <tr>
                <td class="dim small" data-label="ID"><%= l.id %></td>
                <td class="small nowrap" data-label="Fecha"><%= fmtDate(l.created_at) %></td>
                <td data-label="Evento"><span class="badge slate"><%= l.event %></span></td>
                <td class="small nowrap" data-label="IP"><%= l.ip %></td>
                <td class="small log-detail" data-label="Detalle"><%= l.detail %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <p class="dim tiny spaced-sm">Mostrando los 200 más recientes.</p>
    </div>
  <% } %>
</main>

<%- include('../partials/foot') %>
