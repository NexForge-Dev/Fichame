<%
/* Navegação do painel em duas formas da mesma lista:
 *   ≥1024px  barra lateral fixa — aproveita a largura do ecrã de PC
 *   <1024px  separadores no fundo — ao alcance do polegar, que é como o dono
 *            do restaurante usa isto de facto, de pé no estabelecimento
 * O CSS decide qual aparece; não há duplicação de lógica.
 */
var navItems = [
  { href: '/panel',                 icon: 'home',   label: tr('Inicio'),        short: tr('Inicio'),   exact: true },
  { href: '/panel/candidaturas',    icon: 'people', label: tr('Candidaturas'),  short: tr('Candidatos') },
  { href: '/panel/vagas',           icon: 'jobs',   label: tr('Vacantes'),      short: tr('Vacantes') },
  /* O contador são os avisos não lidos (candidaturas novas, pedidos de
   * direitos…), por isso fica em Avisos e não em Candidaturas. */
  { href: '/panel/notificaciones',  icon: 'bell',   label: tr('Avisos'),        short: tr('Avisos'), badge: true },
  { href: '/panel/restaurante',     icon: 'store',  label: tr('Mi negocio'),     short: tr('Mi negocio') },
  /* Derechos e Privacidad usam-se pouco: ficam só em Ajustes (e nos avisos,
   * quando chega um pedido de direitos). */
  { href: '/panel/configuracion',   icon: 'cog',    label: tr('Configuración'), short: tr('Ajustes'), also: ['/panel/derechos', '/panel/privacidad'] },
  /* No telemóvel chega-se pelo aviso da prova e por Ajustes (6 separadores no máximo). */
  { href: '/panel/plan',            icon: 'card',   label: tr('Plan y facturación'), short: tr('Plan'), sideOnly: true },
  { href: '/panel/reportar',        icon: 'chat',   label: tr('Reportar un problema'), short: tr('Reportar'), sideOnly: true }
];

function isActive(item) {
  if (item.exact) return path === item.href;
  return [item.href].concat(item.also || []).some(function(h) { return path.indexOf(h) === 0; });
}

var unread = (typeof unreadCount !== 'undefined' && unreadCount > 0) ? unreadCount : 0;
%>
<aside class="sidenav" aria-label="<%= tr('Navegación principal') %>">
  <a class="brand" href="/panel">
    <img class="brand-mark" src="/img/logo.svg?v=<%= assetV %>" alt="" width="28" height="28">
    <span>Fíchame</span>
  </a>

  <% navItems.forEach(function(item) { %>
    <a class="navlink <%= isActive(item) ? 'active' : '' %>" href="<%= item.href %>"<%- isActive(item) ? ' aria-current="page"' : '' %>>
      <%- icon(item.icon) %>
      <span class="navlabel"><%= item.label %></span>
      <% if (item.badge && unread) { %><span class="nav-badge"><%= unread %></span><% } %>
    </a>
  <% }) %>

  <div class="sidenav-foot">
    <form action="/logout" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn ghost small block" type="submit"><%= tr('Cerrar sesión') %></button>
    </form>
  </div>
</aside>

<header class="appbar">
  <div class="appbar-inner">
    <a class="brand" href="/panel">
      <img class="brand-mark" src="/img/logo.svg?v=<%= assetV %>" alt="" width="28" height="28">
      <span>Fíchame</span>
    </a>
    <span class="brand-sub"><%= typeof restaurantName !== 'undefined' ? restaurantName : '' %></span>
    <div class="appbar-end">
      <form action="/logout" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn secondary small" type="submit"><%= tr('Salir') %></button>
      </form>
    </div>
  </div>
</header>

<nav class="tabbar" aria-label="<%= tr('Navegación principal') %>">
  <%# 6 separadores no máximo; os sideOnly ficam só na barra lateral. %>
  <% navItems.filter(function(item) { return !item.sideOnly; }).forEach(function(item) { %>
    <a class="<%= isActive(item) ? 'active' : '' %>" href="<%= item.href %>"<%- isActive(item) ? ' aria-current="page"' : '' %>>
      <%- icon(item.icon) %>
      <span><%= item.short %></span>
      <% if (item.badge && unread) { %><span class="nav-badge"><%= unread %></span><% } %>
    </a>
  <% }) %>
</nav>
