<% if (typeof isDemo !== 'undefined' && isDemo) { %>
  <div class="flash ok">
    <span><strong><%= tr('Demostración con datos ficticios.') %></strong> <%= tr('Ningún candidato ni negocio de esta cuenta es real y los cambios no se guardan.') %> <a href="/registro"><%= tr('Empieza tus {days} días gratis', { days: pricing.TRIAL_DAYS }) %></a>.</span>
  </div>
<% } %>
<%# Prova grátis (res.locals.trial, só nas páginas do dono). Só informa: não bloqueia nada. %>
<% if (!(typeof isDemo !== 'undefined' && isDemo) && typeof trial !== 'undefined' && trial) { %>
  <div class="flash trial">
    <% if (trial.active) {
      var trialVars = { n: trial.daysLeft, price: pricing.formatPrice(pricing.PLANS.founders.monthly, lang) }; %>
      <span><%= trial.daysLeft === 1
        ? tr('Te queda {n} día de prueba gratis. Después podrás elegir el plan Fundadores ({price}/mes, IVA no incluido) o Profesional.', trialVars)
        : tr('Te quedan {n} días de prueba gratis. Después podrás elegir el plan Fundadores ({price}/mes, IVA no incluido) o Profesional.', trialVars) %>
        <a href="/conoce#precio"><%= tr('Ver precios') %></a></span>
    <% } else { %>
      <span><%= tr('Tu prueba gratuita ha terminado. Pronto podrás activar tu plan desde aquí; mientras tanto puedes seguir usando Fíchame.') %></span>
    <% } %>
  </div>
<% } %>
<% if (!(typeof isDemo !== 'undefined' && isDemo) && typeof termsPending !== 'undefined' && termsPending && path !== '/panel/terminos') { %>
  <div class="flash err">
    <span><%= tr('Hemos actualizado los términos de uso.') %> <a href="/panel/terminos"><%= tr('Revisa los cambios y acéptalos') %></a>.</span>
  </div>
<% } %>
<% if (typeof query !== 'undefined' && query) { %>
  <% if (query.ok) { %><div class="flash ok"><%= tr(query.ok) %></div><% } %>
  <% if (query.err) { %><div class="flash err"><%= tr(query.err) %></div><% } %>
<% } %>
