<%- include('../partials/head', { title: tr('Código QR') }) %>
<%- include('../partials/panel_nav') %>

<main class="container">
  <div class="page-title no-print">
    <h1><%= tr('Código QR') %></h1>
    <a class="back-link" href="/panel/restaurante"><%- icon('arrowLeft') %> <%= tr('Mi negocio') %></a>
  </div>

  <div class="no-print"><%- include('../partials/flash_query') %></div>

  <div class="qr-layout">
  <div class="no-print">
    <p class="muted"><%= tr('Lleva a la página pública de tu negocio. Imprímelo y colócalo a la vista, en la puerta, el escaparate o el mostrador.') %></p>
    <div class="actions-row">
      <button class="btn" type="button" data-print><%- icon('printer') %> <%= tr('Imprimir') %></button>
      <a class="btn secondary" href="/panel/qr.png" download><%- icon('download') %> <%= tr('Descargar PNG') %></a>
    </div>
  </div>

  <!-- Só esta folha sai na impressão (ver @media print no CSS). -->
  <section class="qr-sheet">
    <h2 class="qr-title"><%= restaurant.commercial_name || restaurant.name %></h2>
    <p class="qr-lead"><%= tr('¿Quieres trabajar con nosotros?') %></p>
    <!-- SVG gerado no servidor pela lib qrcode a partir da URL do próprio
         estabelecimento; não contém dados do utilizador além do slug. -->
    <div class="qr-code"><%- qrSvg %></div>
    <p class="qr-cta"><%= tr('Escanea el código con la cámara del móvil para enviar tu candidatura') %></p>
    <p class="qr-url"><%= publicUrl %></p>
  </section>
  </div>
</main>

<%- include('../partials/foot') %>
