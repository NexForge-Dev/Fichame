<%- include('../partials/head', { title: tr('Configuración') }) %>
<%- include('../partials/panel_nav') %>

<main id="main" class="container">
  <div class="page-title">
    <h1><%= tr('Configuración') %></h1>
  </div>

  <%- include('../partials/flash') %>

  <div class="settings-layout">
  <div class="settings-col">
  <div class="card" id="idioma">
    <h2><%= tr('Idioma') %></h2>
    <p class="muted small"><%= tr('Elige el idioma en el que quieres ver Fíchame. Se guarda en este navegador.') %></p>
    <div class="lang-options">
      <% LANGS.forEach(function (l) { %>
        <a class="btn small <%= l === lang ? '' : 'secondary' %>" href="/idioma/<%= l %>?next=/panel/configuracion" lang="<%= l %>"<%- l === lang ? ' aria-current="true"' : '' %>><%= LANG_NAMES[l] %></a>
      <% }) %>
    </div>
    <p class="help"><%= tr('Los textos legales (privacidad, términos y consentimientos) se muestran en español, que es su versión oficial.') %></p>
  </div>

  <div class="card">
    <div class="setting-row">
      <h2><%= tr('Plan y facturación') %></h2>
      <a class="btn secondary small" href="/panel/plan"><%= tr('Ver mi plan') %></a>
    </div>
    <div class="setting-row">
      <h2><%= tr('Privacidad') %></h2>
      <div class="actions-row flat">
        <a class="btn secondary small" href="/panel/derechos"><%= tr('Solicitudes de derechos') %></a>
        <a class="btn secondary small" href="/panel/privacidad"><%= tr('Guía y plazos de conservación') %></a>
      </div>
    </div>
    <div class="setting-row">
      <div class="grow">
        <h2><%= tr('¿Algo no funciona?') %></h2>
        <p class="muted small"><%= tr('Fíchame está en fase de prueba. Cuéntanos errores, dudas o ideas.') %></p>
      </div>
      <a class="btn secondary small" href="/panel/reportar"><%= tr('Reportar un problema') %></a>
    </div>
  </div>
  <% if (googleEnabled || hasGoogle) { %>
  <%- include('settings_google') %>
  <% } %>
  </div>

  <div class="settings-col">
  <div class="card">
    <h2><%= tr('Cuenta de acceso') %></h2>
    <p class="muted small"><%= tr('Email actual:') %> <strong><%= userEmail %></strong></p>
    <% if (typeof pendingEmail !== 'undefined' && pendingEmail) { %>
    <p class="muted small"><%= tr('Cambio pendiente de confirmar:') %> <strong><%= pendingEmail %></strong>. <%= tr('Abre el enlace que te hemos enviado a ese email.') %></p>
    <% } %>

    <% if (!hasPassword) { %>
    <div class="notice-box">
      <strong><%= tr('Entras con Google') %></strong>
      <p><%= tr('Tu cuenta aún no tiene contraseña. Si quieres poder entrar también con email y contraseña, créala desde') %> <a href="/recuperar">«<%= tr('¿Has olvidado tu contraseña?') %>»</a>: <%= tr('te enviaremos un enlace a') %> <strong><%= userEmail %></strong>.</p>
    </div>
    <% } else { %>
    <form action="/panel/configuracion" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="field">
        <label for="email"><%= tr('Nuevo email de acceso') %></label>
        <input id="email" type="email" name="email" maxlength="120" placeholder="<%= tr('Déjalo vacío para no cambiarlo') %>">
        <div class="help"><%= tr('Es el email con el que inicias sesión.') %><% if (emailByLink) { %><%= tr('Te enviaremos un enlace al nuevo email: el cambio solo se hace cuando lo abras.') %><% } %></div>
      </div>
      <% if (!emailByLink) { %>
      <div class="field">
        <label for="email_repetir"><%= tr('Repetir nuevo email') %></label>
        <input id="email_repetir" type="email" name="email_repetir" maxlength="120" autocomplete="off">
        <div class="help"><%= tr('Escríbelo otra vez para evitar errores: si te equivocas, no podrías entrar.') %></div>
      </div>
      <% } %>

      <div class="section-title"><%= tr('Cambiar contraseña') %></div>

      <div class="field">
        <label for="password_actual"><%= tr('Contraseña actual') %> *</label>
        <input id="password_actual" type="password" name="password_actual" required autocomplete="current-password">
        <div class="help"><%= tr('Hace falta siempre, también para cambiar solo el email.') %></div>
      </div>
      <div class="field">
        <label for="password_nuevo"><%= tr('Contraseña nueva') %></label>
        <input id="password_nuevo" type="password" name="password_nuevo" minlength="10" autocomplete="new-password">
        <div class="help"><%= tr('Mínimo 10 caracteres. Déjalo vacío para no cambiarla. Al cambiarla se cierran tus demás sesiones.') %></div>
      </div>
      <div class="field">
        <label for="password_repetir"><%= tr('Repetir contraseña nueva') %></label>
        <input id="password_repetir" type="password" name="password_repetir" autocomplete="new-password">
      </div>

      <button class="btn" type="submit"><%= tr('Guardar configuración') %></button>
    </form>
    <% } %>
  </div>

  <div class="card" id="baja">
    <h2><%= tr('Tus datos y baja') %></h2>
    <p class="muted small"><%= tr('Descarga todas tus candidaturas en una hoja de cálculo. Los CV se descargan desde cada ficha.') %></p>
    <a class="btn secondary small" href="/panel/candidaturas/exportar.csv"><%- icon('download') %> <%= tr('Exportar candidaturas (CSV)') %></a>

    <div class="section-title"><%= tr('Dar de baja el negocio') %></div>
    <p class="muted small"><%= tr('Exporta antes lo que necesites. Revisaremos la solicitud, te escribiremos al email de tu cuenta y cerraremos el negocio con todos sus datos.') %></p>
    <% if (subscriptionLive) { %>
      <p class="help"><%= tr('Tienes una suscripción activa: cancélala antes en') %> <a href="/panel/plan"><%= tr('Plan y facturación') %></a>.</p>
    <% } %>
    <form action="/panel/baja" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="confirmar"><%= tr('Escribe BAJA para confirmar') %></label>
        <input id="confirmar" type="text" name="confirmar" maxlength="10" required autocomplete="off">
      </div>
      <button class="btn danger small" type="submit"><%= tr('Solicitar la baja') %></button>
    </form>
  </div>

  </div>
  </div>
</main>

<%- include('../partials/foot') %>
