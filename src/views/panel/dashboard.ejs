<%- include('../partials/head', { title: tr('Inicio') }) %>
<%- include('../partials/panel_nav') %>

<main id="main" class="container">
  <div class="page-title">
    <h1><%= firstName ? tr('Hola, {name}', { name: firstName }) : tr('Hola de nuevo') %></h1>
  </div>

  <%- include('../partials/flash') %>

  <% if (total === 0) { %>
    <%
      /* Guia de primeiros passos: só enquanto não chegou nenhuma candidatura.
       * É o primeiro ecrã de quem acabou de se registar — deve dizer o que
       * fazer a seguir em vez de mostrar uma grelha de zeros. */
      var steps = [
        { done: openJobs > 0, title: tr('Publica tu primera vacante'), text: tr('Camarero, dependiente, cocina… Los candidatos eligen a cuál se apuntan.'), href: '/panel/vagas', cta: tr('Crear vacante') },
        { done: hasLogo, title: tr('Añade tu logo'), text: tr('Tu página se ve más profesional y los candidatos reconocen tu negocio.'), href: '/panel/restaurante', cta: tr('Subir logo') },
        { done: pageViewed, title: tr('Mira tu página como un candidato'), text: tr('Es lo que se abre al escanear tu QR o abrir tu enlace.'), href: '/panel/ver-pagina', cta: tr('Abrir página'), external: true },
        { done: qrViewed, title: tr('Imprime tu código QR'), text: tr('Imprime el código QR de tu enlace y ponlo a la vista, en la puerta o el mostrador.'), href: '/panel/qr', cta: tr('Código QR') }
      ];
      var doneCount = steps.filter(function (s) { return s.done; }).length;
    %>
    <% if (doneCount < steps.length) { %>
    <section class="card onboarding">
      <div class="onboarding-head">
        <div>
          <h2><%= tr('Primeros pasos') %></h2>
          <p class="muted small flat"><%= tr('En unos minutos tu negocio estará listo para recibir candidaturas.') %></p>
        </div>
        <span class="onboarding-count"><%= doneCount %>/<%= steps.length %></span>
      </div>
      <div class="onboarding-bar"><span class="onboarding-fill onboarding-fill-<%= doneCount %>"></span></div>
      <ol class="steps-list">
        <% var firstOpen = steps.findIndex(function (s) { return !s.done; }); %>
        <% steps.forEach(function (s, i) { %>
          <li class="step-item <%= s.done ? 'is-done' : '' %>">
            <span class="step-mark"><%- s.done ? icon('check') : (i + 1) %></span>
            <div class="grow">
              <strong><%= s.title %></strong>
              <span><%= s.text %></span>
            </div>
            <% if (!s.done) { %>
              <a class="btn <%= i === firstOpen ? '' : 'secondary' %> small" href="<%= s.href %>"<% if (s.external) { %> target="_blank" rel="noopener" data-refresh-on-return<% } %>><%= s.cta %></a>
            <% } %>
          </li>
        <% }) %>
      </ol>
    </section>
    <% } else { %>
    <%
      /* Guia concluído, mas ainda sem candidaturas: em vez de um ecrã vazio,
       * o que ajuda a chegar à primeira — divulgar o link, ver as vagas
       * publicadas e saber onde vão aparecer as candidaturas. */
      var shareText = tr('Estamos contratando en {name}. Envía tu candidatura aquí: {url}', { name: restaurant.name, url: publicUrl });
    %>
    <div class="link-box">
      <div class="label"><%- icon('check') %> <%= tr('Primeros pasos completados') %></div>
      <p class="ready-title"><%= restaurant.hiring === 'open' ? tr('Tu página ya puede recibir candidaturas') : tr('Tu página está lista, pero las candidaturas están en pausa') %></p>
      <div class="url"><%= publicUrl %></div>
      <div class="actions-row flat">
        <button class="btn small" type="button" data-copy="<%= publicUrl %>"><%- icon('copy') %> <%= tr('Copiar enlace') %></button>
        <a class="btn secondary small" href="https://wa.me/?text=<%= encodeURIComponent(shareText) %>" target="_blank" rel="noopener"><%- icon('chat') %> <%= tr('Compartir por WhatsApp') %></a>
        <a class="btn secondary small" href="<%= publicUrl %>" target="_blank" rel="noopener"><%= tr('Ver página') %></a>
        <a class="btn secondary small" href="/panel/qr"><%= tr('Código QR') %></a>
      </div>
      <p class="small link-note"><%= tr('Aún no ha llegado ninguna candidatura. Cuanta más gente vea tu enlace, antes llegará la primera.') %></p>
    </div>

    <div class="card">
      <div class="card-head">
        <h2><%= tr('Vacantes abiertas') %></h2>
        <a class="btn ghost small" href="/panel/vagas"><%= tr('Gestionar') %> <%- icon('arrowRight') %></a>
      </div>
      <div class="app-list">
        <% openJobList.forEach(function (j) { %>
          <a class="app-row" href="/panel/vagas">
            <span class="avatar"><%- icon('jobs') %></span>
            <div class="grow">
              <div class="who"><span class="who-name"><%= j.title %></span></div>
              <div class="meta"><%= j.applicants > 0 ? plural(j.applicants, 'candidatura', 'candidaturas') : tr('Sin candidaturas todavía') %></div>
            </div>
          </a>
        <% }) %>
      </div>
      <% if (openJobs > openJobList.length) { %>
        <p class="small muted spaced-sm"><%= tr('Y {n} más.', { n: openJobs - openJobList.length }) %></p>
      <% } %>
    </div>

    <section class="card">
      <h2><%= tr('Cómo conseguir las primeras candidaturas') %></h2>
      <ol class="steps-list">
        <li class="step-item">
          <span class="step-mark">1</span>
          <div class="grow">
            <strong><%= tr('Comparte el enlace') %></strong>
            <span><%= tr('En el Instagram del negocio, en tu estado de WhatsApp y en tu ficha de Google. Funciona igual que el QR.') %></span>
          </div>
        </li>
        <li class="step-item">
          <span class="step-mark">2</span>
          <div class="grow">
            <strong><%= tr('Pon el QR a la vista') %></strong>
            <span><%= tr('En la puerta, el escaparate o la caja, con un cartel de «Estamos contratando».') %></span>
          </div>
        </li>
        <li class="step-item">
          <span class="step-mark">3</span>
          <div class="grow">
            <strong><%= tr('Responde rápido') %></strong>
            <span><%= tr('Cada candidatura nueva aparece aquí y en') %> <a href="/panel/notificaciones"><%= tr('Avisos') %></a>. <%= tr('Quien recibe respuesta en uno o dos días suele seguir disponible.') %></span>
          </div>
        </li>
      </ol>
    </section>
    <% } %>
  <% } %>

  <%
    /* Primeiro o que fazer agora; os números vêm depois. Quem entra quer
     * saber se há alguém novo e onde carregar. */
    var unread = (typeof unreadCount !== 'undefined') ? unreadCount : 0;
  %>
  <% if (total > 0) { %>
    <section class="card today <%= counts.nuevo > 0 ? 'has-new' : 'is-clear' %>">
      <% if (counts.nuevo > 0) { %>
        <p class="today-title"><%= counts.nuevo === 1 ? tr('Tienes 1 candidatura nueva') : tr('Tienes {n} candidaturas nuevas', { n: counts.nuevo }) %></p>
        <a class="btn" href="/panel/candidaturas?grupo=nuevas"><%= counts.nuevo === 1 ? tr('Verla ahora') : tr('Verlas ahora') %> <%- icon('arrowRight') %></a>
      <% } else { %>
        <div>
          <p class="today-title"><%- icon('check') %> <%= tr('Estás al día') %></p>
          <p class="muted flat"><%= tr('No hay candidaturas nuevas. Te avisaremos cuando llegue una.') %></p>
        </div>
      <% } %>
    </section>

    <div class="kpis">
      <a class="kpi" href="/panel/candidaturas"><span class="num"><%= weekCount %></span><span class="label"><%= tr('Esta semana') %></span></a>
      <a class="kpi" href="/panel/candidaturas"><span class="num"><%= monthCount %></span><span class="label"><%= tr('Este mes') %></span></a>
      <a class="kpi" href="/panel/candidaturas"><span class="num"><%= total %></span><span class="label"><%= tr('En total') %></span></a>
      <a class="kpi" href="/panel/vagas"><span class="num"><%= openJobs %></span><span class="label"><%= tr('Vacantes abiertas') %></span></a>
    </div>
  <% } %>

  <div class="status-strip <%= restaurant.hiring === 'open' ? 'is-open' : 'is-paused' %>">
    <span class="dot dot-lg <%= restaurant.hiring === 'open' ? 'green' : 'amber' %>"></span>
    <div class="grow">
      <% if (restaurant.hiring === 'open') { %>
        <strong><%= tr('Aceptando candidaturas') %></strong>
        <div class="muted small"><%= tr('Tu página está abierta a nuevos candidatos.') %></div>
      <% } else { %>
        <strong><%= tr('Candidaturas en pausa') %></strong>
        <div class="muted small"><%= tr('Tu página muestra «No estamos contratando» y solo recoge datos para futuras oportunidades.') %></div>
      <% } %>
    </div>
    <% if (restaurant.hiring === 'open') { %>
      <%# Pausar fecha a página aos candidatos: pede confirmação, como eliminar uma vaga. %>
      <details>
        <summary class="btn secondary small"><%- icon('pause') %> <%= tr('Pausar candidaturas') %></summary>
        <div class="details-body">
          <p class="help"><%= tr('Tu página mostrará «No estamos contratando». Puedes volver a activarlas cuando quieras.') %></p>
          <form action="/panel/contratacion" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="accion" value="pausar">
            <button class="btn secondary small" type="submit"><%= tr('Sí, pausar candidaturas') %></button>
          </form>
        </div>
      </details>
    <% } else { %>
      <form action="/panel/contratacion" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="accion" value="activar">
        <button class="btn small" type="submit"><%= tr('Activar candidaturas') %></button>
      </form>
    <% } %>
  </div>

  <% if (total > 0) { %>
    <div class="dash-cols">
      <section>
        <div class="page-title">
          <h2><%= tr('Últimas candidaturas') %></h2>
          <a class="btn ghost small" href="/panel/candidaturas"><%= tr('Ver todas') %> <%- icon('arrowRight') %></a>
        </div>

        <div class="app-list">
          <% recent.forEach(function(r) { %>
            <a class="app-row" href="/panel/candidaturas/<%= r.id %>">
              <span class="avatar <%= r.status === 'nuevo' ? 'is-new' : '' %>"><%= initials(r.first_name, r.last_name) %></span>
              <div class="grow">
                <div class="who"><span class="who-name"><%= r.first_name %> <%= r.last_name %></span></div>
                <div class="meta"><%= r.job_title || tr('Sin puesto especificado') %></div>
              </div>
              <div class="right">
                <span class="badge <%= (STATUSES[r.status] || {}).color || 'slate' %>"><%= statusLabel(r.status) %></span>
                <span class="when"><%= fmtRelative(r.applied_at) %></span>
              </div>
            </a>
          <% }) %>
        </div>
      </section>

      <aside>
        <div class="page-title">
          <h2><%= tr('Etapas') %></h2>
        </div>
        <div class="card">
          <%# Totais por etapa; cada linha abre a lista já filtrada. %>
          <ul class="stages">
            <% Object.keys(STATUSES).forEach(function (key) {
                 var n = counts[key] || 0;
                 if (key === 'reserva' && n === 0) return; %>
              <li class="<%= n === 0 ? 'is-zero' : '' %>">
                <a href="/panel/candidaturas?estado=<%= key %>">
                  <span class="dot <%= (STATUSES[key] || {}).color || 'slate' %>"></span>
                  <span><%= statusLabel(key) %></span>
                  <b><%= n %></b>
                </a>
              </li>
            <% }) %>
          </ul>
          <% if (unread > 0) { %>
            <div class="todo-unread spaced-sm">
              <ul class="todo-list grow">
                <li><a href="/panel/notificaciones"><%= plural(unread, 'aviso', 'avisos') %> <%= tr('sin leer') %> <%- icon('arrowRight') %></a></li>
              </ul>
              <form action="/panel/notificaciones/marcar-leidas" method="post">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn ghost small" type="submit"><%= tr('Marcar avisos como leídos') %></button>
              </form>
            </div>
          <% } %>
        </div>
      </aside>
    </div>
  <% } %>
</main>

<%- include('../partials/foot') %>
