<%- include('../partials/head', { title: tr('Mi negocio') }) %>
<%- include('../partials/panel_nav') %>

<main id="main" class="container">
  <div class="page-title">
    <h1><%= tr('Mi negocio') %></h1>
  </div>

  <%- include('../partials/flash') %>

  <!-- O link público (o mesmo do código QR) é o centro do produto: destaque próprio. -->
  <div class="link-box">
    <div class="label"><%- icon('qr') %> <%= tr('URL de tu página pública') %></div>
    <div class="url"><%= publicUrl %></div>
    <div class="actions-row flat">
      <button class="btn small" type="button" data-copy="<%= publicUrl %>"><%- icon('copy') %> <%= tr('Copiar enlace') %></button>
      <a class="btn secondary small" href="<%= publicUrl %>" target="_blank" rel="noopener"><%- icon('external') %> <%= tr('Abrir página') %></a>
      <a class="btn secondary small" href="/panel/qr"><%- icon('qr') %> <%= tr('Generar código QR') %></a>
    </div>
    <p class="small link-note"><%= tr('Comparte esta URL o imprime su código QR. Nunca cambiará, aunque pauses o reactives las candidaturas.') %></p>
  </div>

  <% var isOpen = restaurant.hiring_status === 'open'; %>
  <div class="status-strip <%= isOpen ? 'is-open' : 'is-paused' %>">
    <span class="dot dot-lg <%= isOpen ? 'green' : 'amber' %>"></span>
    <div class="grow">
      <strong><%= isOpen ? tr('Aceptando candidaturas') : tr('Pausado') %></strong>
      <div class="muted small"><%= isOpen
        ? tr('Al pausar, tu página pública mostrará «No estamos contratando» y solo recibirá datos para futuras oportunidades. El enlace y el QR siguen siendo los mismos.')
        : tr('Al activar, el formulario de candidaturas vuelve a estar disponible al instante.') %></div>
    </div>
    <form action="/panel/contratacion" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="accion" value="<%= isOpen ? 'pausar' : 'activar' %>">
      <button class="btn <%= isOpen ? 'secondary' : '' %> small" type="submit"><%= isOpen ? tr('Pausar candidaturas') : tr('Activar candidaturas') %></button>
    </form>
  </div>

  <div class="card">
    <h2><%= tr('Datos del negocio') %></h2>
    <form action="/panel/restaurante" method="post" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-grid">
      <div class="field">
        <label for="name"><%= tr('Nombre del negocio') %> *</label>
        <input id="name" type="text" name="name" maxlength="100" required value="<%= restaurant.name %>">
      </div>
      <div class="field">
        <label for="commercial_name"><%= tr('Nombre comercial') %> <span class="dim label-hint">(<%= tr('opcional') %>)</span></label>
        <input id="commercial_name" type="text" name="commercial_name" maxlength="100" value="<%= restaurant.commercial_name %>">
        <div class="help"><%= tr('Es el nombre que verán los candidatos en tu página pública.') %></div>
      </div>
      <div class="field">
        <label for="establecimiento"><%= tr('Tipo de negocio') %> *</label>
        <select id="establecimiento" name="establecimiento" required>
          <option value=""><%= tr('Selecciona…') %></option>
          <% Object.keys(ESTABLISHMENT_TYPES).forEach(function(key) { %>
            <option value="<%= key %>" <%= restaurant.establishment_type === key ? 'selected' : '' %>><%= ESTABLISHMENT_TYPES[key] %></option>
          <% }) %>
        </select>
      </div>
      <div class="field span-2">
        <label for="descripcion"><%= tr('Descripción') %></label>
        <textarea id="descripcion" name="descripcion" maxlength="1500" rows="3"><%= restaurant.description %></textarea>
      </div>
      <div class="field">
        <label for="legal_name"><%= tr('Razón social o nombre del titular') %> *</label>
        <input id="legal_name" type="text" name="legal_name" maxlength="150" required value="<%= restaurant.legal_name %>">
        <div class="help"><%= tr('Se muestra a los candidatos como responsable del tratamiento de sus datos.') %></div>
      </div>
      <div class="field">
        <label for="privacy_email"><%= tr('Email de contacto para privacidad') %> *</label>
        <input id="privacy_email" type="email" name="privacy_email" maxlength="120" required value="<%= restaurant.privacy_email || restaurant.email %>">
        <div class="help"><%= tr('Público: los candidatos lo ven para ejercer sus derechos. Aquí recibirás también los avisos de solicitudes.') %></div>
      </div>
      <div class="field">
        <label for="owner_name"><%= tr('Persona de contacto') %> *</label>
        <input id="owner_name" type="text" name="owner_name" maxlength="100" required value="<%= restaurant.owner_name %>">
      </div>
      <div class="field">
        <label for="email"><%= tr('Email para avisos de candidaturas') %> *</label>
        <input id="email" type="email" name="email" maxlength="120" required value="<%= restaurant.email %>">
        <div class="help"><%= tr('Los avisos no incluyen datos del candidato: solo un enlace a tu panel.') %></div>
      </div>
      <div class="field">
        <label for="telefono"><%= tr('Teléfono') %> <span class="dim label-hint">(<%= tr('opcional') %>)</span></label>
        <input id="telefono" type="tel" name="telefono" maxlength="30" value="<%= restaurant.phone %>">
      </div>
      <div class="field span-2">
        <label for="direccion"><%= tr('Dirección') %></label>
        <input id="direccion" type="text" name="direccion" maxlength="200" value="<%= restaurant.address %>">
      </div>
      <div class="hint-row span-2">
        <div class="field">
          <label for="cp"><%= tr('Código postal') %></label>
          <input id="cp" type="text" name="cp" maxlength="5" pattern="\d{5}" inputmode="numeric" value="<%= restaurant.postal_code %>">
        </div>
        <div class="field">
          <label for="ciudad"><%= tr('Ciudad') %> *</label>
          <input id="ciudad" type="text" name="ciudad" maxlength="100" required value="<%= restaurant.city %>">
        </div>
      </div>
      </div>

      <div class="section-title"><%= tr('Imágenes de tu página pública') %></div>
      <p class="help help-lift"><%= tr('PNG, JPG o WEBP · máximo {mb} MB. Se muestran en la página pública que ven los candidatos.', { mb: maxImgMb }) %></p>
      <div class="hint-row">
        <div class="field">
          <label for="logo"><%= tr('Logo') %></label>
          <div class="file-pick">
            <input class="file-pick-input" id="logo" type="file" name="logo" accept="image/png,image/jpeg,image/webp,.png,.jpg,.jpeg,.webp">
            <label class="file-pick-box" for="logo">
              <span class="file-pick-icon"><%- icon('file') %></span>
              <span class="file-pick-text">
                <strong data-file-action data-empty="<%= tr('Elegir imagen') %>" data-change="<%= tr('Cambiar archivo') %>"><%= tr('Elegir imagen') %></strong>
                <span><%= tr('PNG, JPG o WEBP') %></span>
              </span>
            </label>
          </div>
          <div class="file-name" data-file-name></div>
          <% if (restaurant.logo_path) { %>
            <div class="img-preview">
              <img src="/r/<%= restaurant.slug %>/imagen/logo?v=<%= String(restaurant.logo_path).split('/').pop() %>" alt="<%= tr('Logo actual') %>">
              <label class="check check-plain">
                <input type="checkbox" name="borrar_logo" value="1">
                <span><%= tr('Eliminar logo') %></span>
              </label>
            </div>
          <% } %>
        </div>
        <div class="field">
          <label for="foto"><%= tr('Foto') %></label>
          <div class="file-pick">
            <input class="file-pick-input" id="foto" type="file" name="foto" accept="image/png,image/jpeg,image/webp,.png,.jpg,.jpeg,.webp">
            <label class="file-pick-box" for="foto">
              <span class="file-pick-icon"><%- icon('file') %></span>
              <span class="file-pick-text">
                <strong data-file-action data-empty="<%= tr('Elegir imagen') %>" data-change="<%= tr('Cambiar archivo') %>"><%= tr('Elegir imagen') %></strong>
                <span><%= tr('PNG, JPG o WEBP') %></span>
              </span>
            </label>
          </div>
          <div class="file-name" data-file-name></div>
          <% if (restaurant.photo_path) { %>
            <div class="img-preview">
              <img src="/r/<%= restaurant.slug %>/imagen/foto?v=<%= String(restaurant.photo_path).split('/').pop() %>" alt="<%= tr('Foto actual') %>">
              <label class="check check-plain">
                <input type="checkbox" name="borrar_foto" value="1">
                <span><%= tr('Eliminar foto') %></span>
              </label>
            </div>
          <% } %>
        </div>
      </div>

      <button class="btn" type="submit"><%= tr('Guardar cambios') %></button>
    </form>
  </div>

  <div class="card card-tight">
    <h2><%= tr('Tu slug') %></h2>
    <p class="muted small flat"><strong>/<%= restaurant.slug %></strong> — <%= tr('identificador único de tu negocio en la plataforma.') %></p>
    <p class="help"><%= tr('Contacta con soporte si necesitas cambiarlo: cambiarlo invalidaría tu enlace y los códigos QR que ya hayas impreso.') %></p>
  </div>
</main>

<%- include('../partials/foot') %>
