<%- include('../partials/head', {
  title: restaurant.commercial_name || restaurant.name,
  description: restaurant.description || tr('Envía tu candidatura en menos de 2 minutos, desde el móvil y sin crear ninguna cuenta.'),
  ogImage: restaurant.logo_path ? '/r/' + restaurant.slug + '/imagen/logo' : (restaurant.photo_path ? '/r/' + restaurant.slug + '/imagen/foto' : ''),
  ogPath: '/r/' + restaurant.slug
}) %>
<%
  /* Atributos de acessibilidade de um campo com erro: o leitor de ecrã
     anuncia o campo como inválido e lê a mensagem associada. */
  function invalid(name) {
    return (errors && errors[name]) ? ' aria-invalid="true" aria-describedby="err-' + name + '"' : '';
  }
  var hasErrors = Boolean(errors && Object.keys(errors).length > 0);
%>

<header class="hero <%= restaurant.photo_path ? 'has-photo' : '' %>">
  <% if (restaurant.photo_path) { %>
    <!-- Fotografia como fundo através de <img> e não de background-image:
         o CSP é `style-src 'self'` e bloqueia estilos inline. -->
    <img class="hero-photo" src="/r/<%= restaurant.slug %>/imagen/foto?v=<%= String(restaurant.photo_path).split('/').pop() %>" alt="" aria-hidden="true">
  <% } %>

  <div class="container-narrow hero-body">
    <% if (restaurant.logo_path) { %>
      <img class="hero-logo" src="/r/<%= restaurant.slug %>/imagen/logo?v=<%= String(restaurant.logo_path).split('/').pop() %>" alt="<%= tr('Logo de {name}', { name: restaurant.name }) %>">
    <% } %>

    <h1><%= restaurant.commercial_name || restaurant.name %></h1>

    <% if (restaurant.establishment_type && ESTABLISHMENT_TYPES[restaurant.establishment_type]) { %>
      <p class="sub"><%= ESTABLISHMENT_TYPES[restaurant.establishment_type] %></p>
    <% } %>

    <% if (restaurant.description) { %>
      <p class="hero-desc"><%= restaurant.description %></p>
    <% } %>

    <% if (restaurant.address || restaurant.city) { %>
      <p class="sub hero-place">
        <%= restaurant.address %><% if (restaurant.postal_code) { %>, <%= restaurant.postal_code %><% } %><% if (restaurant.address && restaurant.city) { %> · <% } %><%= restaurant.city %>
      </p>
    <% } %>

    <% if (mode === 'form') { %>
      <span class="badge-open"><span class="dot green"></span> <%= tr('Estamos contratando') %></span>
    <% } else { %>
      <span class="badge-closed"><span class="dot red"></span> <%= tr('No estamos contratando') %></span>
    <% } %>
  </div>
</header>

<main class="container-narrow public-main">

<% if (restaurant.demo) { %>
  <div class="flash ok"><strong><%= tr('Página de demostración.') %></strong> <%= tr('Este negocio es ficticio y el formulario no envía nada.') %> <a href="/registro"><%= tr('Crea la página de tu negocio gratis') %></a>.</div>
<% } %>

<% if (typeof query !== 'undefined' && query && query.err) { %>
  <div class="flash err"><%= tr(query.err) %></div>
<% } %>

<% if (mode === 'form') { %>

  <% if (jobs.length > 0) { %>
    <div class="card">
      <h2><%= tr('Vacantes abiertas') %></h2>
      <p class="help help-lift"><%= tr('Puedes elegir una en el formulario, o dejarlo sin especificar.') %></p>
      <% jobs.forEach(function(job) { %>
        <div class="job-item">
          <div class="title"><%= job.title %></div>
          <% if (job.description) { %><p class="desc"><%= job.description %></p><% } %>
          <% if (job.contract_type || job.work_schedule) { %>
            <div class="row spaced-sm">
              <% if (job.contract_type && CONTRACT_TYPES[job.contract_type]) { %>
                <span class="badge slate"><%= CONTRACT_TYPES[job.contract_type] %></span>
              <% } %>
              <% if (job.work_schedule && WORK_SCHEDULES[job.work_schedule]) { %>
                <span class="badge slate"><%= WORK_SCHEDULES[job.work_schedule] %></span>
              <% } %>
            </div>
          <% } %>
        </div>
      <% }) %>
    </div>
  <% } %>

  <div class="card" id="enviar">
    <h2><%= tr('Envía tu candidatura') %></h2>
    <p class="help help-lift"><%= tr('Menos de 2 minutos. Solo necesitas tus datos y tu CV en PDF. No hace falta crear ninguna cuenta.') %></p>

    <% if (errors && errors.general) { %>
      <div class="flash err"><%= errors.general.map(function(e) { return tr(e); }).join(' ') %></div>
    <% } else if (hasErrors) { %>
      <div class="flash err" role="alert"><%= tr('Revisa los campos marcados en rojo.') %></div>
    <% } %>

    <%# #enviar: depois de um erro a página volta já posicionada no formulário. %>
    <form action="/r/<%= restaurant.slug %>/apply#enviar" method="post" enctype="multipart/form-data" data-busy="<%= tr('Enviando tu CV…') %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="hp" aria-hidden="true">
        <label>Sitio web</label>
        <input type="text" name="sitio_web" tabindex="-1" autocomplete="off">
      </div>

      <div class="section-title"><%= tr('Tus datos') %></div>

      <div class="field">
        <label for="nombre"><%= tr('Nombre') %> *</label>
        <input id="nombre" type="text" name="nombre" minlength="2" maxlength="100" required value="<%= form.nombre || '' %>" autocomplete="given-name"<%- invalid('nombre') %>>
        <% if (errors && errors.nombre) { %><div class="field-error" id="err-nombre"><%= tr(errors.nombre) %></div><% } %>
      </div>

      <div class="field">
        <label for="apellidos"><%= tr('Apellidos') %> <span class="dim label-hint"><%= tr('(opcional)') %></span></label>
        <input id="apellidos" type="text" name="apellidos" maxlength="100" value="<%= form.apellidos || '' %>" autocomplete="family-name">
      </div>

      <div class="field">
        <label for="email"><%= tr('Email') %> *</label>
        <input id="email" type="email" name="email" maxlength="120" required value="<%= form.email || '' %>" autocomplete="email" inputmode="email"<%- invalid('email') %>>
        <% if (errors && errors.email) { %><div class="field-error" id="err-email"><%= tr(errors.email) %></div><% } %>
      </div>

      <div class="field">
        <label for="telefono"><%= tr('Número de teléfono') %> *</label>
        <input id="telefono" type="tel" name="telefono" maxlength="25" pattern="[0-9\s\(\)\.\+\-]{6,25}" required value="<%= form.telefono || '' %>" autocomplete="tel" inputmode="tel"<%- invalid('telefono') %>>
        <% if (errors && errors.telefono) { %><div class="field-error" id="err-telefono"><%= tr(errors.telefono) %></div><% } %>
      </div>

      <div class="section-title"><%= tr('El puesto') %></div>

      <div class="field">
        <label for="puesto"><%= tr('Puesto al que aspiras') %> <span class="dim label-hint"><%= tr('(opcional)') %></span></label>
        <select id="puesto" name="puesto"<%- invalid('puesto') %>>
          <option value=""><%= tr('No especifico / cualquiera') %></option>
          <% jobs.forEach(function(job) { %>
            <option value="<%= job.id %>" <%= String(form.puesto) === String(job.id) ? 'selected' : '' %>><%= job.title %></option>
          <% }) %>
          <option value="otro" <%= form.puesto === 'otro' ? 'selected' : '' %>><%= tr('Otro') %></option>
        </select>
        <% if (errors && errors.puesto) { %><div class="field-error" id="err-puesto"><%= tr(errors.puesto) %></div><% } %>
      </div>

      <div class="field <%= form.puesto === 'otro' ? '' : 'is-hidden' %>" id="otro-puesto-field">
        <label for="otro_puesto"><%= tr('¿Qué puesto?') %></label>
        <input id="otro_puesto" type="text" name="otro_puesto" maxlength="80" value="<%= form.otro_puesto || '' %>">
      </div>

      <div class="field">
        <label for="disponibilidad"><%= tr('Disponibilidad') %> <span class="dim label-hint"><%= tr('(opcional)') %></span></label>
        <select id="disponibilidad" name="disponibilidad">
          <% Object.keys(AVAILABILITIES).forEach(function(key) { %>
            <option value="<%= key %>" <%= form.disponibilidad === key ? 'selected' : '' %>><%= AVAILABILITIES[key] %></option>
          <% }) %>
        </select>
      </div>

      <div class="field">
        <label for="experiencia"><%= tr('Experiencia') %> <span class="dim label-hint"><%= tr('(opcional)') %></span></label>
        <textarea id="experiencia" name="experiencia" maxlength="2000" placeholder="<%= tr('Ej.: 2 años de atención al cliente en…') %>"><%= form.experiencia || '' %></textarea>
      </div>

      <div class="field">
        <label for="observaciones"><%= tr('Observaciones') %> <span class="dim label-hint"><%= tr('(opcional)') %></span></label>
        <textarea id="observaciones" name="observaciones" maxlength="1000" placeholder="<%= tr('Ej.: puedo incorporarme en dos semanas.') %>"><%= form.observaciones || '' %></textarea>
      </div>

      <div class="notice-box">
        <strong><%= tr('Comparte solo lo necesario para el puesto.') %></strong>
        <p><%= tr('No hace falta —ni en el formulario ni en el CV— tu DNI/NIE, fecha de nacimiento, nacionalidad, estado civil, fotografía, ni datos sobre salud, discapacidad, religión, ideas políticas, afiliación sindical, origen étnico u orientación sexual. Si tu CV los incluye, puedes quitarlos antes de enviarlo.') %></p>
      </div>

      <div class="section-title"><%= tr('Tu currículum') %></div>

      <div class="field">
        <label for="cv"><%= tr('CV en PDF') %> *</label>
        <div class="file-pick">
          <input class="file-pick-input" id="cv" type="file" name="cv" accept="application/pdf,.pdf" required data-max-bytes="<%= maxUploadMb * 1024 * 1024 %>" data-too-big="<%= tr('El archivo supera el límite de {n} MB.', { n: maxUploadMb }) %>"<%- invalid('cv') %>>
          <label class="file-pick-box" for="cv">
            <span class="file-pick-icon"><%- icon('file') %></span>
            <span class="file-pick-text">
              <strong data-file-action data-empty="<%= tr('Elegir PDF') %>" data-change="<%= tr('Cambiar archivo') %>"><%= tr('Elegir PDF') %></strong>
              <span><%= tr('Toca para buscar tu CV en el móvil') %></span>
            </span>
          </label>
        </div>
        <div class="file-name" data-file-name></div>
        <div class="help"><%= tr('PDF · máximo {n} MB', { n: maxUploadMb }) %></div>
        <% if (errors && errors.cv) { %>
          <div class="field-error" id="err-cv"><%= tr(errors.cv, { n: maxUploadMb }) %></div>
        <% } else if (hasErrors) { %>
          <%# O browser nunca conserva o ficheiro escolhido quando a página volta com erros. %>
          <div class="field-error" id="err-cv"><%= tr('Por seguridad, el navegador no guarda el archivo: vuelve a adjuntar tu CV.') %></div>
        <% } %>
        <div class="field-error is-hidden" data-file-error role="alert"></div>
      </div>

      <div class="section-title"><%= tr('Protección de datos') %></div>

      <%# A informação de privacidade e o consentimento ficam em espanhol (versão oficial). %>
      <% if (lang !== 'es') { %><p class="help"><%= tr('Los textos legales (privacidad, términos y consentimientos) se muestran en español, que es su versión oficial.') %></p><% } %>

      <%- include('privacy_layer', { purpose: 'gestionar tu candidatura en este proceso de selección', basis: 'La aplicación, a petición tuya, de medidas precontractuales: tú nos envías la candidatura para optar a un empleo (art. 6.1.b RGPD). No necesitas dar ningún consentimiento para candidatarte.', keep: 'Mientras el proceso siga abierto y, como máximo, ' + retention.inactive + ' sin actividad. Cuando el proceso termine, se borran en ' + retention.closed + ', salvo que marques la casilla de abajo.' }) %>

      <label class="check">
        <input type="checkbox" name="consentimiento_futuro" value="1" <%= form.consent_futuro ? 'checked' : '' %>>
        <span><strong><%= tr('Opcional.') %></strong> <span lang="es"><%= consentFutureText %></span></span>
      </label>

      <p class="help"><%= tr('Los campos con * son obligatorios.') %></p>
      <button class="btn block lg spaced" type="submit"<%= restaurant.demo ? ' disabled' : '' %>><%= tr('Enviar candidatura') %></button>
    </form>
  </div>

<% } else { %>

  <div class="card">
    <% if (mode === 'paused') { %>
      <h2><%= tr('Actualmente no estamos contratando.') %></h2>
      <p class="muted"><%= tr('Puedes volver a consultar más adelante.') %></p>
    <% } else { %>
      <h2><%= tr('Actualmente no tenemos vacantes disponibles.') %></h2>
      <p class="muted"><%= tr('Déjanos tus datos y te contactaremos cuando haya una oportunidad.') %></p>
    <% } %>

    <div class="section-title"><%= tr('¿Quieres que guardemos tu candidatura para futuras oportunidades?') %></div>

    <% if (errors && errors.general) { %>
      <div class="flash err"><%= errors.general.map(function(e) { return tr(e); }).join(' ') %></div>
    <% } %>

    <form action="/r/<%= restaurant.slug %>/interes" method="post" data-busy="<%= tr('Enviando…') %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="hp" aria-hidden="true">
        <label>Sitio web</label>
        <input type="text" name="sitio_web" tabindex="-1" autocomplete="off">
      </div>

      <div class="field">
        <label for="nombre"><%= tr('Nombre') %> *</label>
        <input id="nombre" type="text" name="nombre" maxlength="100" required value="<%= form.nombre || '' %>" autocomplete="given-name">
      </div>
      <div class="field">
        <label for="email"><%= tr('Email') %> *</label>
        <input id="email" type="email" name="email" maxlength="120" required value="<%= form.email || '' %>" inputmode="email" autocomplete="email">
      </div>
      <div class="field">
        <label for="telefono"><%= tr('Teléfono') %> *</label>
        <input id="telefono" type="tel" name="telefono" maxlength="25" pattern="[0-9\s\(\)\.\+\-]{6,25}" required value="<%= form.telefono || '' %>" inputmode="tel" autocomplete="tel">
      </div>
      <div class="field">
        <label for="experiencia"><%= tr('¿En qué te gustaría trabajar?') %></label>
        <textarea id="experiencia" name="experiencia" maxlength="500" rows="3" placeholder="<%= tr('Ej.: camarero/a o dependiente/a, 2 años de experiencia, disponible por las tardes.') %>"><%= form.experiencia || '' %></textarea>
        <div class="help"><%= tr('Opcional. Una frase basta. No incluyas datos personales que no sean necesarios.') %></div>
      </div>

      <%# A informação de privacidade e o consentimento ficam em espanhol (versão oficial). %>
      <% if (lang !== 'es') { %><p class="help"><%= tr('Los textos legales (privacidad, términos y consentimientos) se muestran en español, que es su versión oficial.') %></p><% } %>

      <%- include('privacy_layer', { purpose: 'avisarte si surge una vacante en este establecimiento', basis: 'Tu consentimiento (art. 6.1.a RGPD), que das marcando la casilla. Puedes retirarlo cuando quieras.', keep: 'Durante ' + retention.reserve + ' desde hoy, o hasta que retires el consentimiento.' }) %>

      <label class="check">
        <input type="checkbox" name="consentimiento_futuro" value="1" <%= form.consent_futuro ? 'checked' : '' %>>
        <span><span lang="es"><%= consentInterestText %></span> *</span>
      </label>

      <button class="btn block lg" type="submit"<%= restaurant.demo ? ' disabled' : '' %>><%= tr('Guardar mi candidatura') %></button>
    </form>
  </div>

<% } %>
</main>

<%- include('../partials/foot') %>
