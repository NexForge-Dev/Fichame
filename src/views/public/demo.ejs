<%- include('../partials/head', { title: tr('Demostración de Fíchame') }) %>

<%- include('../partials/site_top') %>

<main id="main" class="container-narrow error-main">
  <div class="card center pad-lg">
    <h1><%= tr('Demostración de Fíchame') %></h1>
    <p class="muted"><%= tr('Ningún candidato ni negocio de esta cuenta es real y los cambios no se guardan.') %></p>
    <form action="/demo" method="post" class="actions-row center-row spaced">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
