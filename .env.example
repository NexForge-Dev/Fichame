# Fíchame — variáveis de ambiente
#
# Copiar para `.env` e preencher. O `.env` está no .gitignore e NUNCA deve ser
# versionado. Este ficheiro de exemplo não contém valores secretos (§28).

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------

PORT=3000

# URL pública gravada nas etiquetas NFC (sem barra no fim).
# Em produção: https://o-teu-dominio.com
APP_URL=http://localhost:3000

# Email de contacto na página de apresentação /conoce (opcional). Sem ele, a
# secção «Ayúdanos a mejorar» mostra só o botão de registo.
CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Painel → Project Settings → API
#
# SUPABASE_URL              https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY         chave publishable/anon — pode ser pública
# SUPABASE_SERVICE_ROLE_KEY chave secret/service_role — SÓ no backend
#
# A SUPABASE_SERVICE_ROLE_KEY ignora Row Level Security. Nunca a coloques no
# frontend, num ficheiro versionado, em código público ou em logs.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Buckets do Storage (criados pela migration 0003)
SUPABASE_BUCKET_CVS=cvs
SUPABASE_BUCKET_MEDIA=media

# Ligação direta ao Postgres — usada APENAS por `npm run migrate`, porque o
# supabase-js não executa DDL. A aplicação em si nunca usa isto.
# Supabase → Project Settings → Database → Connection string → URI
# Se a ligação direta falhar (projetos recentes são só IPv6), usar a do
# "Session pooler" na porta 5432.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Sessões e cookies
# ---------------------------------------------------------------------------

SESSION_TTL_DAYS=30

# 1 = cookie enviado só por HTTPS (obrigatório em produção).
# Na Vercel fica 1 se não for definido; não copiar o 0 para lá.
COOKIE_SECURE=0

# 1 = confiar no proxy (um salto) para X-Forwarded-Proto/For.
# Na Vercel fica 1 se não for definido.
TRUST_PROXY=0

# ---------------------------------------------------------------------------
# Login com Google (opcional, gratuito)
# ---------------------------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (tipo «Web application»). URI de redirecionamento autorizado:
#   <APP_URL>/login/google/callback
# Sem estes dois valores o botão «Continuar con Google» não aparece; também não
# aparece se o client id não terminar em .apps.googleusercontent.com (aviso no log).
# O client secret é secreto: só no backend, nunca versionado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------

# Tamanho máximo do CV em PDF, em MB. Na Vercel nunca passa de 4
# (o limite de 4,5 MB por pedido corta antes de chegar à app).
MAX_CV_MB=4

# Tamanho máximo do logo/foto do estabelecimento, em MB
MAX_IMAGE_MB=2

# ---------------------------------------------------------------------------
# Admin da plataforma (usado por `npm run setup`)
# ---------------------------------------------------------------------------

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador Fíchame

# ---------------------------------------------------------------------------
# SMTP — notificação de nova candidatura
# ---------------------------------------------------------------------------
# Sem SMTP_HOST os emails NÃO são enviados (e o conteúdo não vai para o log).
# Sem SMTP não há avisos por email e a recuperação de senha passa a ser manual:
# o pedido aparece em /admin/usuarios e o admin define a senha nova.
# O email nunca leva o CV em anexo: leva um link para o painel (§21).

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@fichame.local

# SMTP_INSECURE=1   # aceitar certificado TLS inválido ou servidor sem STARTTLS (apenas testes locais)

# ---------------------------------------------------------------------------
# Stripe — assinaturas (Checkout e Customer Portal alojados pela Stripe)
# ---------------------------------------------------------------------------
# Sem STRIPE_SECRET_KEY E STRIPE_WEBHOOK_SECRET a cobrança fica desligada: o
# painel mostra os planos com «el pago online se activará pronto» e sem botões.
# A chave PUBLICÁVEL (pk_...) NÃO é precisa: o pagamento é feito todo em
# checkout.stripe.com (não carregamos Stripe.js).
#
# STRIPE_SECRET_KEY      Dashboard → Developers → API keys (sk_test_… primeiro)
# STRIPE_WEBHOOK_SECRET  whsec_… do endpoint <APP_URL>/webhooks/stripe
#                        (Dashboard → Developers → Webhooks; ver LANCAMENTO.md)
# As duas são secretas: só no backend, nunca versionadas nem em logs.
#
# Os preços NÃO se configuram aqui: `npm run stripe:setup` cria o produto e os
# preços a partir de src/lib/pricing.js (lookup_key fichame_<plano>_<período>_<cêntimos>).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Em produção (VERCEL_ENV=production) uma chave sk_test_ é recusada, salvo com
# STRIPE_ALLOW_TEST=1 (ensaio com cartões de teste no domínio real).
STRIPE_ALLOW_TEST=
# O inverso: em preview/development da Vercel uma chave sk_live_ é recusada,
# salvo com STRIPE_ALLOW_LIVE=1.
STRIPE_ALLOW_LIVE=

# Configuração do Customer Portal só do Fíchame (bpc_…). A conta Stripe é
# partilhada com outros produtos: sem isto usa-se a configuração por omissão
# da conta. `npm run stripe:setup` cria-a e mostra o id.
STRIPE_PORTAL_CONFIGURATION_ID=

# IVA: os preços são «IVA no incluido» (tax_behavior exclusive).
# 1 = Stripe Tax calcula o IVA (exige registo do IVA espanhol em Stripe Tax).
# 0 = sem Stripe Tax; aplica-se a taxa fixa STRIPE_TAX_RATE_ID (txr_…, IVA 21 %
#     exclusive criada no Dashboard → Product catalog → Tax rates), se definida.
STRIPE_AUTOMATIC_TAX=0
STRIPE_TAX_RATE_ID=

# ---------------------------------------------------------------------------
# Identificação do operador (art. 10 LSSI, art. 13 RGPD)
# ---------------------------------------------------------------------------
# Aparecem em /privacidad, /terminos e /encargo. Enquanto vazios, as páginas
# mostram [RAZÓN SOCIAL], [NIF]… — nunca dados inventados.
OPERATOR_LEGAL_NAME=
OPERATOR_NIF=
OPERATOR_ADDRESS=
OPERATOR_PRIVACY_EMAIL=
OPERATOR_REGISTRY=
# Só se tiver sido designado um DPD/DPO
OPERATOR_DPO=

# 1 = textos legais revistos por advogado: esconde a faixa «BORRADOR — REQUIERE
# REVISIÓN JURÍDICA». Só definir depois da revisão real.
LEGAL_REVIEWED=

# ---------------------------------------------------------------------------
# Retenção e logs (docs/legal/00-legal-review-required.md)
# ---------------------------------------------------------------------------
# Supressão automática via GET /internal/retention (ex.: Vercel Cron), com
# Authorization: Bearer <CRON_SECRET>. Desligada até RETENTION_AUTO=1 —
# ligar SÓ depois de os prazos estarem validados juridicamente.
# CRON_SECRET: mínimo 32 caracteres (ex.: `openssl rand -hex 32`). Também ativa
# a limpeza técnica diária (/internal/cleanup, Vercel Cron em vercel.json);
# vazio ou com menos de 32 caracteres, a limpeza não corre.
CRON_SECRET=
RETENTION_AUTO=0
# Dias de conservação dos logs de segurança e dos pedidos de direitos fechados
SECURITY_LOG_DAYS=365
RIGHTS_REQUEST_DAYS=1095
# Dias de conservação dos erros do servidor e dos reportes já resolvidos
ERROR_EVENT_DAYS=90
REPORT_DAYS=365
# Recebe por email o aviso de cada reporte novo (/panel/reportar), se houver SMTP
# (é o mesmo ADMIN_EMAIL da secção «Admin da plataforma»)
# Segredo para pseudonimizar emails nos logs (por omissão deriva da service key)
LOG_HMAC_SECRET=

# --- Painel NexForge (métricas internas, opcional) ---------------------------
# Sem as três variáveis nada é enviado. Só eventos mínimos com id pseudónimo do
# negócio; nunca dados de candidatos. Chave: Painel → Administração → Projetos.
NEXFORGE_ENDPOINT=
NEXFORGE_INGEST_KEY=
# Aleatório e exclusivo deste produto (openssl rand -base64 32). Nunca o partilhes.
NEXFORGE_PSEUDONYM_SECRET=
